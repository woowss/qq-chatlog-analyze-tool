# API Key
.env
.secret_key

# Flask session files
flask_session/

# Uploaded chat files
uploads/*.json

# AI analysis result cache (derived from chat logs — sensitive)
ai_cache/

# Python cache
__pycache__/
*.pyc
*.pyo

# Logs（含轮转出的 app.log.1/.2，整目录忽略）
logs/

# Upload directory
uploads/

# 本地统计缓存（由聊天记录派生：条数/日期/高频词，同样敏感）
stats_cache/

# 表情原图缓存（QQ 表情图，可选功能抓下来的）
face_cache/

# 本机杂物目录（出图脚本、模型下载、docx 拆包产物等，与本项目无关）。
# 必须忽略，理由不只是"别被 git add -A 收进来"：ruff 默认尊重 .gitignore，
# 这个目录没被忽略时，`ruff check .` 与 `ruff format --check .` 会把里面那些
# 一次性脚本一起判为违规（实测 24 个错误、10 个文件待重排全部来自这里），
# 于是本地跑 CI 同款命令必然红，掩盖了真正的问题。
temp/

# 测试/开发临时产物
*.whl
*.tmp
.tmp_*
*.bak
*.orig
# 打包产物（python -m build 的默认输出目录；本地核对用 .tmp_dist/）
dist/
build/
*.egg-info/

# 本地审计/核对产物（2026-09 隐私审计留下：上游克隆、审计报告、扫描脚本与 venv）。
# 它们不是项目内容，但也不该被 git add -A 顺手收进仓库。
privacy-audit-report.md
analysis-repo/
_audit/
