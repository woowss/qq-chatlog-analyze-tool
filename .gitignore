# API Key
.env
.secret_key

# Flask session files
flask_session/

# Uploaded chat files
uploads/*.json

# AI analysis result cache (derived from chat logs — sensitive)
ai_cache/

# Python cache
__pycache__/
*.pyc
*.pyo

# Logs（含轮转出的 app.log.1/.2，整目录忽略）
logs/

# Upload directory
uploads/

# 本地统计缓存（由聊天记录派生：条数/日期/高频词，同样敏感）
stats_cache/

# 表情原图缓存（QQ 表情图，可选功能抓下来的）
face_cache/

# 测试/开发临时产物
*.whl
*.tmp
.tmp_*
*.bak
*.orig
# 打包产物（python -m build 的默认输出目录；本地核对用 .tmp_dist/）
dist/
build/
*.egg-info/

# 本地审计/核对产物（2026-09 隐私审计留下：上游克隆、审计报告、扫描脚本与 venv）。
