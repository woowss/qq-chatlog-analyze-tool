# ============================================
# 【必填】LLM API 配置（任何 OpenAI 兼容接口均可）
# ============================================
# 示例一：DeepSeek 官方 — https://platform.deepseek.com/api_keys 创建 Key
#   DEEPSEEK_MODEL=deepseek-flash        （DeepSeek-V4.1-Flash，1M 上下文，支持 JSON Output）
#   DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
#   也可用 deepseek-v4-pro（V4 Pro 计划下线，届时请求会自动路由到 V4.1 Flash 并按 Flash 计费）
# 示例二：阿里云 Token Plan（Qwen）
#   DEEPSEEK_MODEL=qwen3.8-flash
#   DEEPSEEK_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# ============================================
DEEPSEEK_API_KEY=你的API_Key

# 模型与接口地址（默认 DeepSeek 官方，按需替换为上面任一方案）
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 思考模式（仅 DeepSeek V4 系列）：**官方端点默认全维度开启**（准确性优先，
# 思维链能显著提升证据引用质量）；各维度输出预算已相应提到 32k/49k，不会再出现
# "思维链吃满预算 → 结果被截断丢弃"。切到非官方网关时默认不发送该参数。
# 想省钱/提速可显式关闭：LLM_THINKING=disabled（或只用白名单 LLM_THINKING_DIMS=profile）
# LLM_THINKING=disabled
# LLM_THINKING_DIMS=profile

# ============================================
# 可选运行 / 安全配置（默认值即安全）
# ============================================
# 调试模式：默认关闭。Werkzeug 调试器可执行任意代码，仅本机开发时临时开启
# FLASK_DEBUG=true
# 绑定地址与端口：默认仅本机可访问。Windows 上 5000 常被 AirPlay/Hyper-V 占用，可改 5001
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000
# 访问口令：设置后访问任何页面需先登录；绑定非回环地址（如 0.0.0.0）时必填，否则拒绝启动
# ACCESS_PASSWORD=
# 允许的浏览器来源主机名（逗号分隔）：POST 的 Origin 校验默认只放行回环地址与 FLASK_HOST。
# 用局域网 IP 或自定义域名访问时必须在这里列出，否则上传/分析请求会被 403 拒绝。
# 例：ALLOWED_ORIGINS=192.168.1.5,chat.lan
# ALLOWED_ORIGINS=
# Session 签名密钥：留空则自动生成并持久化到 .secret_key（已被 .gitignore 忽略）
# SECRET_KEY=

# ============================================
# AI 调用节流（默认值已按服务商自适应，通常不用改）
# 官方 DeepSeek：并发 6 / 间隔 0.5s；其他网关（如百炼）：并发 2 / 间隔 3s
# 注意 _pace() 是串行闸门：N 次调用的排队下限是 (N-1)×间隔，直接决定多月份分析的耗时
# ============================================
# LLM_CONCURRENCY=6
# LLM_CALL_MIN_INTERVAL=0.5
# 单月喂给模型的最大字符数（默认 600000 ≈ 25-30 万 tokens，装得下绝大多数月份的
# 全部消息，正常情况下不抽样）；调小可显著省费用，代价是长月份被等间隔抽样
# LLM_MAX_DIALOG_CHARS=600000
# 月份级增量缓存（默认开）：重新导出同一段对话时只为新增月份付费；设 0 关闭
# QQCHAT_MONTH_CACHE=1
# 无引用的月份缓存宽限期（小时，默认 24；越短越注重隐私、增量复用窗口越小）
# LLM_MONTH_CACHE_GRACE_HOURS=24
# 手动失效缓存的盐值：正常情况下改提示词/格式会自动换缓存键（PROMPT_FINGERPRINT），
# 只有在"源码不可读的打包环境里改了格式逻辑"才需要设一个新值强制全部重算
# PROMPT_CACHE_SALT=
# 内存任务表条目存活秒数（默认 900；分析结果本身永远先落盘，此项只影响轮询余命）
# QQCHAT_JOB_TTL_SECONDS=900

# ============================================
# 隐私与数据生命周期
# ============================================
# 日志按天轮转、只保留 N 天（默认 7）：日志行可能出现昵称与导出文件名，不留无限历史
# LOG_RETENTION_DAYS=7
# 日志脱敏（默认开）：昵称只留首字、原始文件名不落日志；本地排查问题时设为 false
# LOG_REDACT_NAMES=true
# 群聊防线：默认拒绝 2 人以上发言者的导出文件（否则"其他人"会静默并进"对方"，全盘失真）。
# 确要按"我 vs 其他人"两分类分析时才放行
# QQCHAT_ALLOW_MULTI_PARTY=0

# ============================================
# 图片理解（视觉）：让模型"看"聊天里的截图 / 表情包 / 照片
# deepseek-flash 原生支持图片输入（每张图最多 1024 tokens，官方按约 1300x1300 折算）
# ============================================
# 媒体根目录：导出器的图片放在导出目录的 resources/ 下，而本工具只接收 JSON，
# 所以需要告诉它资源在哪（通常填导出目录本身）。留空 = 不做图片理解。
# QQCHAT_MEDIA_DIR=C:\Users\你的用户名\Documents\QQChatExporter\exports
# 总开关（默认开）。设为 false 即完全不上传任何图片，回到纯文本分析
# LLM_VISION=true
# 每月最多送几张图（默认 20，约 2 万 tokens/月）：摘要按图片指纹缓存，
# 换维度/重跑都不再重复付费
# LLM_VISION_MAX_PER_MONTH=20
# 清晰度：high 保留原图（截图里的字看得清）；low 压到 512x512（更省 token）
# LLM_VISION_DETAIL=high
# 小于该像素的图按表情包跳过（默认 200，按最长边判断）
# LLM_VISION_MIN_SIDE=200
# 单张图片体积上限（默认 12 MiB；官方 base64 上限 32 MiB）
# LLM_VISION_MAX_BYTES=12582912

# ============================================
# 原始表情图（可选，默认关闭）
# 打开后可在「习惯」页点一次「获取原始表情图」，把 QQ 表情原图缓存到本地，此后离线复用。
# 覆盖范围：经典黄脸（按名称反查 CDN 编号）与商城表情（用导出文件自带的地址），
# 实测约覆盖 58% 的表情使用次数；QQ 超级表情（吃糖/大怨种/菜汪…）没有公开地址，抓不到，
# 这类会继续用 Unicode emoji 或表情名渲染，不影响其它功能。抓取失败（离线/404）会静默跳过。
# ============================================
# QQCHAT_FACE_IMAGES=true
# 本地表情包目录（优先于联网）：文件名支持 <编号>.gif / e<编号+100>.gif / <表情名>.gif
# 想 100% 原样（含超级表情）就把它指向你自己导出的表情图目录
# QQCHAT_FACE_DIR=
# 表情图缓存目录（默认随数据目录）
# FACE_CACHE_DIR=
# 一次抓取的上限与单张超时（秒）
# QQCHAT_FACE_FETCH_LIMIT=300
# QQCHAT_FACE_FETCH_TIMEOUT=6

# ============================================
# 数据目录（默认在项目内；测试/多实例时可指向别处）
# ============================================
# QQCHAT_DATA_DIR=D:\qqchatlog-data
# UPLOAD_DIR= / SESSION_DIR= / AI_CACHE_DIR= / STATS_CACHE_DIR= / LOG_DIR= 可单独覆盖

# ============================================
# 费用估算（元 / 百万 tokens，用于用量卡片的"约 ¥x"）
# 默认按 DeepSeek 标准价：flash 2/8，v4-pro 9/27；空闲时段约为半价
# ============================================
# LLM_PRICE_IN=2
# LLM_PRICE_OUT=8
